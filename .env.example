# Hollis Blue Collar Frontend — Environment Template
# NOTE: All VITE_ variables are embedded into the static bundle during `npm run build`.

# Backend REST API Versioned Root (REQUIRED - must end with /api/v1)
VITE_BASE_URL=https://api.yourdomain.com/api/v1

# Media / Static Host Root (REQUIRED - backend base domain without /api)
VITE_API_BASE_URL=https://api.yourdomain.com

# Stripe Publishable Key (REQUIRED for Stripe Elements)
VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_publishable_key

# Google Integration Keys (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
